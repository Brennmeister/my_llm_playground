# Copy to .env and adjust. All values are optional.

# --- LLM / llama-server (used by install.sh, start.sh and docker compose) ---
# Pick ONE model block. After switching run ./install.sh (native) or restart
# `docker compose up` - the new model is downloaded once.

# Option 1 (default): Qwen3.5-0.8B - fastest, ~1.5 GB RAM in total, ~20-30 s per 1-page order on CPU
# Q8_0 (~0.8 GB) = best quality for 0.8B; Q4_K_M (~0.5 GB) for very weak devices
MODEL_REPO=unsloth/Qwen3.5-0.8B-GGUF
MODEL_FILE=Qwen3.5-0.8B-Q8_0.gguf
LLM_MODEL_NAME=qwen3.5-0.8b

# Option 2: Qwen3.5-2B - next size up, noticeably better at parties, tables and long orders.
# Still edge friendly: Q4_K_M = 1.3 GB file, ~2.5 GB RAM in total, roughly 2-2.5x slower on CPU.
# Use Qwen3.5-2B-Q6_K.gguf (1.6 GB) for slightly better quality if RAM allows.
#MODEL_REPO=unsloth/Qwen3.5-2B-GGUF
#MODEL_FILE=Qwen3.5-2B-Q4_K_M.gguf
#LLM_MODEL_NAME=qwen3.5-2b
# Vision projector of the model repo: the LLM also SEES the pages (faint print, stamps, handwriting).
# Empty = text only. Docker downloads it automatically with the model.
MMPROJ_FILE=mmproj-BF16.gguf
LLM_PORT=8081
LLM_CTX=8192
# GPU layers: 99 = all on GPU (if a CUDA/Vulkan build is installed), 0 = CPU only
LLM_NGL=99
# CPU threads: empty = auto. On notebooks use the number of PHYSICAL performance cores.
LLM_THREADS=

# --- API (used by start.sh) ---
API_HOST=127.0.0.1
API_PORT=8000

# --- App settings (read by app/config.py) ---
# Images for the model: all = every page, scans = OCR'd pages only, off = text only
LLM_IMAGES=all
# Image budget of the header call (all pages of a chunk share it); row strips are ~200 tokens each
LLM_PAGE_IMAGE_TOKENS=1500
LLM_BASE_URL=http://127.0.0.1:8081
MAX_CHARS_PER_CHUNK=9000
OCR_LANGUAGES=deu+eng+pol+ita
# Your own company name(s), comma separated - helps to tell buyer and supplier apart
OWN_COMPANY_NAMES=
DEFAULT_CURRENCY=EUR
